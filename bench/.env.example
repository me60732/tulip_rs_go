# Shared database connection string (same as Python/Rust benchmarks)
DATABASE_URL=postgres://tulip:tulip@localhost:5432/stocks?sslmode=disable

# Benchmark results database (separate schema for logged runs)
BENCHMARK_DATABASE_URL=postgres://tulip:tulip@localhost:5432/indicator_benchmark?sslmode=disable

# Logging control
BENCHMARK_LOG_TO_DB=0
ENABLE_BENCHMARK_LOGGING=0

# Timing knobs (mirrors Python/Rust naming)
BENCH_NUMBER=10
BENCH_REPEAT=30000
BENCH_WARMUP=1000
